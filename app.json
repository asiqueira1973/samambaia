{
  "expo": {
    "name": "Samambaia",
    "slug": "samambaia",
    "version": "1.0.0",
    "scheme": "samambaia",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.dablab.samambaia",
      "supportsTablet": false,
      "requireFullScreen": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dablab.samambaia",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#1F6B3B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "./plugins/with-local-notifications-only",
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Samambaia usa suas fotos para você escolher a imagem de cada planta.",
          "cameraPermission": "O Samambaia usa a câmera para você fotografar suas plantas.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F6B3B",
          "defaultChannel": "regas"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F6B3B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    },
    "owner": "alexsiq"
  }
}
